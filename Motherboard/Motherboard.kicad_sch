		(uuid "0885849b-adf0-40a7-9260-faa9c3c9befd")
	)
	(text "#define WS2812_EXTERNAL_PULLUP\n#define WS2812_PWM_DRIVER PWMD2\n#define WS2812_PWM_CHANNEL 4\n#define WS2812_PWM_PAL_MODE 2\n#define WS2812_PWM_DMAMUX_ID STM32_DMAMUX1_TIM2_UP\n//DMAMUX value can be 1-12"
		(exclude_from_sim no)
		(at 114.3 252.73 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1ccfd1e3-c1f8-41e1-a1ef-56f9e2e62414")
	)
	(text "When R(ILIM) = 56k @ 1%\nILIM (MIN) = 25230/(56^(1.016)) ~= 422mA\nILIM (NOM) = 23950/(56^(0.977)) ~= 469mA\nILIM (MAX) = 22980/(56^(0.94)) ~= 522mA"
		(exclude_from_sim no)
		(at 143.51 63.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3e17edfe-7b77-4350-acc2-82ce92b9d580")
	)
	(text "Takes about 2s for boot0 to reach 1.61V."
		(exclude_from_sim no)
		(at 241.3 215.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right bottom)
		)
		(uuid "72a5cc50-8784-43a8-bb86-fbbb36d9bb5e")
	)
	(text "RGB: TIM2_CH4 - AF2"
		(exclude_from_sim no)
		(at 114.3 251.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "797547b8-77bf-4bdc-9448-445b1ccf439c")
	)
	(text "Series and parallel resistors used here so that if one"
		(exclude_from_sim no)
		(at 250.19 54.61 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "812c771a-86bd-40d9-b559-f3327733625e")
	)
	(text "VBUS detect: #define USB_VBUS_PIN B10"
		(exclude_from_sim no)
		(at 114.3 240.03 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "854ba4a1-a837-4481-9832-edf727956441")
	)
	(text "side is unplugged, then the inputs aren't left floating,"
		(exclude_from_sim no)
		(at 250.19 57.15 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a3b4abc5-45a9-445d-99b0-00458656773c")
	)
